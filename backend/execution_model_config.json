{
  "execution": {
    "mode": "simulated",
    "dry_run": true,
    "max_positions": 10,
    "max_position_value": 5000,
    "risk_level": "medium"
  },
  "models": {
    "ai_signal": {
      "enabled": true,
      "confidence_threshold": 0.65,
      "update_interval_minutes": 30
    },
    "rsi": {
      "enabled": true,
      "overbought": 70,
      "oversold": 30,
      "period": 14
    },
    "dual_bot": {
      "enabled": true,
      "primary_model": "ai_signal",
      "secondary_model": "rsi",
      "consensus_required": true
    }
  },
  "risk_management": {
    "stop_loss_percent": 2.0,
    "take_profit_percent": 5.0,
    "trailing_stop": false,
    "max_daily_loss_percent": 5.0,
    "position_sizing_method": "fixed"
  },
  "reporting": {
    "enabled": true,
    "interval_minutes": 60,
    "include_inactive_models": false
  }
} 