# Dual Bot Environment Variables

# Data Sources
POLYGON_API_KEY=your_polygon_api_key_here
UNUSUAL_WHALES_API_KEY=your_unusual_whales_api_key_here
NEWS_API_KEY=your_news_api_key_here
SEC_API_KEY=your_sec_api_key_here

# AI Models
# OpenAI (ChatGPT)
# We're using OpenRouter to access OpenAI models
# Keep this field empty as we're using OpenRouter instead
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo

# OpenRouter (for multiple LLM access including GPT-4 and DeepSeek)
# This key is used to access both OpenAI and DeepSeek models
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4-turbo

# DeepSeek via OpenRouter
# Using OpenRouter API to access DeepSeek models
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# Valid DeepSeek models on OpenRouter: deepseek/deepseek-r1, deepseek/deepseek-chat-v3, deepseek/deepseek-chat-v3-0324
DEEPSEEK_MODEL=deepseek/deepseek-r1

# Anthropic (for reference/future use)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Hume AI Configuration
HUME_API_KEY=your_hume_api_key_here
HUME_SECRET_KEY=your_hume_secret_key_here
HUME_EVI_WEBSOCKET_URL=wss://api.hume.ai/v0/evi/chat

# Execution
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_API_SECRET=your_alpaca_api_secret_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Notifications
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Logging
LOG_LEVEL=INFO 