{
  "model": {
    "enabled": true,
    "version": "2.0",
    "risk_threshold": 0.7,
    "confidence_threshold": 0.6,
    "max_positions": 10
  },
  "risk_management": {
    "max_portfolio_risk_percent": 20,
    "max_position_size_percent": 5,
    "position_sizing_method": "equal_risk",
    "stop_loss": {
      "enabled": true,
      "percent": 5,
      "trailing": false
    },
    "take_profit": {
      "enabled": true,
      "percent": 10
    }
  },
  "ai": {
    "openai": {
      "enabled": true,
      "model": "gpt-4",
      "api_key": "",
      "temperature": 0.3,
      "max_tokens": 1000
    },
    "hume": {
      "enabled": false,
      "api_key": ""
    }
  },
  "signals": {
    "sources": ["tradingview", "unusual_whales", "internal"],
    "ranking": {
      "method": "weighted",
      "weights": {
        "tradingview": 0.5,
        "unusual_whales": 0.3,
        "internal": 0.2
      }
    },
    "filters": {
      "min_confidence": 0.6,
      "max_risk": 0.7,
      "market_cap_min": 1000000000
    }
  },
  "execution": {
    "auto_execute": true,
    "trading_hours_only": true,
    "rebalance_frequency": "daily",
    "market_hours": {
      "start": "09:30",
      "end": "16:00",
      "timezone": "America/New_York"
    }
  }
} 